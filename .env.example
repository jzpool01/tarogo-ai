# 代理服务监听端口
PORT=3000

# 默认上游 OpenAI 兼容地址（不要带 /v1，程序会自动兼容两种写法）
DEFAULT_BASE_URL=https://api.tarogo.com

# 本地 Ollama 模型路由（默认启用）
# 请求的模型在本地清单中时，直接转发到本机 Ollama 的 OpenAI 兼容端点
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
# 本地模型清单缓存毫秒数（避免每个请求都探测 Ollama）
OLLAMA_CACHE_TTL=10000
# 探测 Ollama 超时毫秒数（连接失败时快速降级到默认上游）
OLLAMA_TIMEOUT=1500